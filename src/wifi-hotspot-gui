    # ---------- helpers
    def make_list(self, placeholder):
        lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        lb.add_css_class("boxed-list")
        lb.set_placeholder(Gtk.Label(label=placeholder, margin_top=12, margin_bottom=12))
        return lb

    def toast(self, msg):
        # Adw.Toast titles are Pango markup; backend errors may contain < or &
        self.toasts.add_toast(Adw.Toast(title=esc(msg), timeout=5))

    def error_dialog(self, heading, body):
        dlg = Adw.AlertDialog(heading=heading, body=body)  # body is plain text
        dlg.add_response("ok", "OK")
        dlg.present(self)

    def report(self, res, ok_msg):
        rc, out, err = res
        if rc == 0:
            if ok_msg:
                self.toast(ok_msg)
        elif rc in (126, 127):
            self.toast("Cancelled")
        else:
            self.toast((err or out or "Failed").splitlines()[-1][:200])
        return rc == 0

    # ---------- state
    def sync_state(self):
        up = os.path.exists(AP)
        if self.sw.get_active() != up:
            self.sw.handler_block(self._sw_id)
            self.sw.set_active(up)
            self.sw.handler_unblock(self._sw_id)
        if self.sw.get_sensitive():
            if up:
                text = "On: " + self.saved.get("SSID", "")
                if "TOTAL_BYTES" in self.saved:
                    text += "  \u00b7  " + human(to_int(self.saved["TOTAL_BYTES"])) + " used"
                    cap = to_int(self.saved.get("CAP_MB"))
                    if cap:
                        text += " of " + human(cap * 1048576)
                self.sw.set_subtitle(esc(text))
            else:
                self.sw.set_subtitle("Off")

    def tick(self):
        susp = getattr(self, "is_suspended", None)   # GTK >= 4.12: skip work while minimised/hidden
        if susp and susp():
            return True
        conf = read_kv(CONF_F)
        up = os.path.exists(AP)
        snap = read_status() if up else None
        self.saved.pop("TOTAL_BYTES", None)
        self.saved.update(conf)
        rows, ts = [], 0.0
        if snap:
            kv, rows = snap
            if "TOTAL_BYTES" in kv:
                self.saved["TOTAL_BYTES"] = kv["TOTAL_BYTES"]
            self._channel = kv.get("CHANNEL", "") or self._channel
            try:
                ts = float(kv.get("TS", 0))
            except ValueError:
                ts = 0.0
        elif time.monotonic() - self._iw_t > 15:     # off: look at the Wi-Fi channel now and then
            self._iw_t = time.monotonic()
            bg(lambda: read_channel(conf.get("STA", "")), lambda ch: setattr(self, "_channel", ch))
        self.band.set_subtitle(band_text(self._channel))

        approved = sorted(m.lower() for m in read_lines(ALLOW_F))
        self.approved = set(approved)
        if approved != self._last_approved:
            self._last_approved = approved
            self.fill_macs(self.approved_lb, approved, "Remove", "disallow")
        blocked = [m.lower() for m in read_lines(DENY_F)]
        if blocked != self._last_blocked:
            self._last_blocked = blocked
            self.fill_macs(self.blocked_lb, blocked, "Unblock", "unblock")

        self.show_clients(rows, ts)
        self.sync_state()
        return True

    @staticmethod
    def parse_kv(out):
        return dict(l.split("=", 1) for l in out.splitlines() if "=" in l)

    def on_switch(self, *_):
        want = self.sw.get_active()
        self.sw.set_sensitive(False)
        self.sw.set_subtitle("Starting..." if want else "Stopping...")

        def done(res):
            self.sw.set_sensitive(True)
            rc, out, err = res
            if rc != 0:
                msg = (err or out or "Failed").strip()
                if want and rc != 126:  # 126 = pkexec dismissed
                    # the backend's message already carries the hostapd log tail
                    # (/run/hotspot-hostapd.log is root-only, so we cannot read it here)
                    self.error_dialog("Hotspot could not start", msg[-1500:])
                else:
                    self.toast(msg.splitlines()[-1][:200])
            self.sync_state()
        bg(lambda: run(["start" if want else "stop"]), done)

    # ---------- settings
    def load_settings(self):
        kv = read_kv(CONF_F)
        if not kv:
            self.toast("No settings yet: run  sudo wifi-hotspot init  once")
        self.saved = kv
        self.ssid.set_text(kv.get("SSID", ""))
        self.maxc.set_value(to_int(kv.get("MAXCLIENTS"), 8))
        self.rate.set_value(to_int(kv.get("RATE")))
        keys = [k for k, _ in SEC]
        self.sec.set_selected(keys.index(kv["SECURITY"]) if kv.get("SECURITY") in keys else 0)
        self.iso.set_active(kv.get("ISOLATE") == "1")
        self.acl.set_active(kv.get("ALLOWLIST") == "1")
        self.idle.set_value(to_int(kv.get("IDLE_MIN")))
        self.cap.set_value(to_int(kv.get("CAP_MB")) / 1024)
        self.ntf.set_active(kv.get("NOTIFY", "1") != "0")
        self.spi.set_active(kv.get("SHOW_PANEL_ICON", "1") != "0")
        self.sync_state()

    def on_save(self, *_):
        ssid, pw = self.ssid.get_text(), self.pw.get_text()
        if not ssid or len(ssid.encode()) > 32:
            return self.toast("Network name must be 1-32 bytes")
        if pw and not (8 <= len(pw) <= 63 and "|" not in pw):
            return self.toast("Password: 8-63 characters, no | character")
        def flag(sw):
            return "1" if sw.get_active() else "0"
        args = ["apply", ssid,
                str(int(self.maxc.get_value())),
                str(int(self.rate.get_value()) or ""),
                SEC[self.sec.get_selected()][0],
                flag(self.iso), flag(self.acl),
                str(int(self.idle.get_value())),
                str(int(round(self.cap.get_value() * 1024))),
                flag(self.ntf),
                flag(self.spi)]

        def done(res):
            if self.report(res, "Saved"):
                self.pw.set_text("")
                self.load_settings()
        # password goes via stdin so it never appears in the command line or system logs
        bg(lambda: run(args, root=True, stdin=pw + "\n"), done)

    # ---------- password + QR
    def on_reveal(self, *_):
        def done(res):
            rc, out, err = res
            if rc != 0:
                self.report(res, "")
                return
            self.open_connect_dialog(self.saved.get("SSID", ""), out.rstrip("\n"),
                                     self.saved.get("SECURITY", "wpa2"))
        bg(lambda: run(["secret"], root=True, raw=True), done)

    def open_connect_dialog(self, ssid, pw, sec):
        dlg = Adw.Dialog(title="Connect to hotspot", content_width=400)
        tv = Adw.ToolbarView()
        tv.add_top_bar(Adw.HeaderBar())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16,
                      margin_top=12, margin_bottom=24, margin_start=24, margin_end=24)
        box.append(qr_widget(wifi_qr_payload(ssid, pw, sec)))
        g = Adw.PreferencesGroup()
        g.add(Adw.ActionRow(title="Network name", subtitle=esc(ssid), subtitle_selectable=True))
        r = Adw.ActionRow(title="Password", subtitle=esc(pw), subtitle_selectable=True)
        cp = Gtk.Button(icon_name="edit-copy-symbolic", valign=Gtk.Align.CENTER,
                        tooltip_text="Copy password")
        cp.add_css_class("flat")

        def copy(btn):
            self.get_clipboard().set(pw)
            btn.set_icon_name("object-select-symbolic")
        cp.connect("clicked", copy)
        r.add_suffix(cp)
        g.add(r)
        box.append(g)
        tv.set_content(box)
        dlg.set_child(tv)
        dlg.present(self)

    # ---------- connected devices
    def device_menu(self, mac, approved):
        pop = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)

        def item(label, cb):
            b = Gtk.Button(label=label)
            b.add_css_class("flat")
            b.get_child().set_halign(Gtk.Align.START)
            b.connect("clicked", lambda *_: (pop.popdown(), cb()))
            box.append(b)
        item("Limit speed\u2026", lambda: self.limit_dialog(mac))
        if not approved:
            item("Approve", lambda: self.change_list("allow", mac))
        item("Block", lambda: self.change_list("block", mac))
        pop.set_child(box)
        mb = Gtk.MenuButton(icon_name="view-more-symbolic", valign=Gtk.Align.CENTER, popover=pop)
        mb.add_css_class("flat")
        return mb

    def show_clients(self, rows, ts=0.0):
        # rows: (mac, ip, name, down, up, limit_down, limit_up)
        macs = [r[0] for r in rows]
        key = (tuple(macs), tuple(m in self.approved for m in macs))
        if key != self._row_key:  # rebuild only when the device set or approval state changes
            self._row_key = key
            self._rows = {}
            self.clients_lb.remove_all()
            for mac, ip, name, *_ in rows:
                title = name if name not in ("-", "*") else "Unknown device"
                r = Adw.ActionRow(title=esc(title))
                r.add_suffix(self.device_menu(mac, mac in self.approved))
                self.clients_lb.append(r)
                self._rows[mac] = r
        self._latest = {}
        for gone in [m for m in self._prev if m not in macs]:
            del self._prev[gone]
            self._spd.pop(gone, None)
        for mac, ip, name, down, up, ld, lu in rows:
            self._latest[mac] = (ld, lu)
            prev = self._prev.get(mac)
            if prev is None or ts > prev[2]:         # new snapshot: recompute live speed
                sd = su = 0.0
                if prev and down >= prev[0] and up >= prev[1]:
                    dt = ts - prev[2]
                    sd, su = (down - prev[0]) * 8 / dt, (up - prev[1]) * 8 / dt
                self._prev[mac] = (down, up, ts)
                self._spd[mac] = (sd, su)
            sd, su = self._spd.get(mac, (0.0, 0.0))
            lines = [f"{ip} \u00b7 {mac}",
                     f"\u2193 {human(down)}  \u2191 {human(up)}   now \u2193 {speed(sd)}  \u2191 {speed(su)}"]
            if ld or lu:
                lines.append("Limit: \u2193 " + (f"{ld}" if ld else "none") +
                             "  \u2191 " + (f"{lu}" if lu else "none") + " Mbit/s")
            self._rows[mac].set_subtitle(esc("\n".join(lines)))

    def limit_dialog(self, mac):
        ld, lu = self._latest.get(mac, (0, 0))
        dlg = Adw.AlertDialog(heading="Limit speed", body=f"{mac}\n0 = no limit")
        g = Adw.PreferencesGroup()
        down = Adw.SpinRow(title="Download (Mbit/s)",
                           adjustment=Gtk.Adjustment(lower=0, upper=1000, step_increment=1, value=ld))
        up = Adw.SpinRow(title="Upload (Mbit/s)",
                         adjustment=Gtk.Adjustment(lower=0, upper=1000, step_increment=1, value=lu))
        g.add(down)
        g.add(up)
        dlg.set_extra_child(g)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("save", "Save")
        dlg.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("save")
        dlg.set_close_response("cancel")

        def response(_d, r):
            if r != "save":
                return
            args = ["limit", mac, str(int(down.get_value())), str(int(up.get_value()))]
            bg(lambda: run(args, root=True), lambda res: (self.report(res, "Limit saved"), self.tick()))
        dlg.connect("response", response)
        dlg.present(self)

    # ---------- approved / blocked lists
    def fill_macs(self, lb, macs, label, action):
        lb.remove_all()
        for mac in macs:
            r = Adw.ActionRow(title=esc(mac))
            b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
            b.connect("clicked", lambda _b, m=mac: self.change_list(action, m))
            r.add_suffix(b)
            lb.append(r)

    def change_list(self, action, mac):
        def done(res):
            self.report(res, f"{DONE[action]} {mac}")
            self.tick()
        bg(lambda: run([action, mac], root=True), done)

    def on_add_mac(self, *_):
        m = self.add_mac.get_text().strip().lower()
        if not MAC_RE.fullmatch(m):
            return self.toast("Format: aa:bb:cc:dd:ee:ff")
        self.add_mac.set_text("")
        self.change_list("allow", m)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="local.sudar.Hotspot")

    def do_activate(self):
        (self.props.active_window or Win(self)).present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
