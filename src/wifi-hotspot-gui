#!/usr/bin/env python3
import os
import re
import subprocess
import sys
import threading
import time

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gtk

HS = "/usr/local/sbin/wifi-hotspot"
AP = "/sys/class/net/ap0"
# World-readable state: read directly, so polling needs no sudo and spawns no processes.
CONF_F, ALLOW_F, DENY_F = "/etc/hotspot.conf", "/etc/hotspot.allow", "/etc/hotspot.deny"
STATUS_F = "/run/hotspot-status"      # snapshot written every few seconds by `wifi-hotspot watch`
SEC = [("wpa2", "WPA2-Personal"),
       ("wpa2wpa3", "WPA2/WPA3-Personal"),
       ("wpa3", "WPA3-Personal")]
MAC_RE = re.compile(r"([0-9a-f]{2}:){5}[0-9a-f]{2}")
DONE = {"block": "Blocked", "unblock": "Unblocked", "allow": "Approved", "disallow": "Removed"}


def run(args, root=False, stdin=None, raw=False):
    """root=False: passwordless sudo (only start/stop need it; see the sudoers file). If sudo
    wants a password it falls back to pkexec. root=True: pkexec (system password prompt)."""
    def go(prefix):
        try:
            return subprocess.run(prefix + [HS] + list(args), input=stdin,
                                  capture_output=True, text=True, timeout=300)
        except subprocess.TimeoutExpired:
            return None
    p = go(["pkexec"] if root else ["sudo", "-n"])
    if p is not None and not root and p.returncode != 0 \
            and p.stderr.startswith("sudo:") \
            and ("password" in p.stderr or "authentication" in p.stderr):
        p = go(["pkexec"])
    if p is None:
        return 124, "", "timed out"
    return p.returncode, (p.stdout if raw else p.stdout.strip()), p.stderr.strip()


def bg(fn, done):
    def work():
        res = fn()

        def finish():
            done(res)
            return False  # GLib.SOURCE_REMOVE: a truthy return would re-run the callback
        GLib.idle_add(finish)
    threading.Thread(target=work, daemon=True).start()


def esc(s):
    return GLib.markup_escape_text(s)


def human(n):
    n = float(n)
    for u in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f} {u}" if u == "B" else f"{n:.1f} {u}"
        n /= 1024
    return f"{n:.1f} TB"


def speed(bps):
    return f"{bps / 1e6:.1f} Mbit/s" if bps >= 1e6 else f"{bps / 1e3:.0f} kbit/s"


def band_text(ch):
    if not ch:
        return "Not connected to Wi-Fi, hotspot cannot start"
    ch = int(ch)
    band = "2.4 GHz" if ch <= 14 else "5 GHz"
    return f"{band}, channel {ch} (follows your Wi-Fi connection)"


def wifi_qr_payload(ssid, pw, sec):
    def e(s):
        return re.sub(r'([\\;,:"])', r"\\\1", s)

    t = "SAE" if sec == "wpa3" else "WPA"
    return f"WIFI:T:{t};S:{e(ssid)};P:{e(pw)};;"


def qr_widget(data):
    try:
        import qrcode
    except ImportError:
        return Gtk.Label(label="QR needs: sudo apt install python3-qrcode", wrap=True)
    qr = qrcode.QRCode(border=0, error_correction=qrcode.constants.ERROR_CORRECT_M)
    qr.add_data(data)
    qr.make(fit=True)
    m = qr.get_matrix()
    n, quiet = len(m), 4
    total = n + 2 * quiet
    scale = max(3, 320 // total)
    px = total * scale
    white, black = b"\xff\xff\xff", b"\x00\x00\x00"
    rows = []
    for y in range(total):
        if quiet <= y < quiet + n:
            line = (white * (quiet * scale)
                    + b"".join((black if v else white) * scale for v in m[y - quiet])
                    + white * (quiet * scale))
        else:
            line = white * px
        rows.append(line * scale)
    tex = Gdk.MemoryTexture.new(px, px, Gdk.MemoryFormat.R8G8B8,
                                GLib.Bytes.new(b"".join(rows)), px * 3)
    pic = Gtk.Picture.new_for_paintable(tex)
    pic.set_can_shrink(False)
    pic.set_halign(Gtk.Align.CENTER)
    return pic


def read_kv(path):
    d = {}
    try:
        with open(path) as f:
            for line in f:
                if "=" in line:
                    k, v = line.rstrip("\n").split("=", 1)
                    d[k] = v
    except OSError:
        pass
    return d


def read_lines(path):
    try:
        with open(path) as f:
            return [x.strip() for x in f if x.strip()]
    except OSError:
        return []


def read_status():
    """Snapshot from `wifi-hotspot watch`: (kv, client rows) or None if missing/stale."""
    try:
        if time.time() - os.stat(STATUS_F).st_mtime > 20:
            return None
        with open(STATUS_F) as f:
            text = f.read()
    except OSError:
        return None
    kv, rows = {}, []
    for line in text.splitlines():
        if line.startswith("CLIENT\t"):
            f = line.split("\t")[1:]
            if len(f) == 7 and all(x.isdigit() for x in f[3:]):
                rows.append((f[0], f[1], f[2]) + tuple(int(x) for x in f[3:]))
        elif "=" in line:
            k, v = line.split("=", 1)
            kv[k] = v
    return kv, rows


def read_channel(want=""):
    """Channel of the connected Wi-Fi interface (`iw dev` needs no root)."""
    try:
        out = subprocess.run(["iw", "dev"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    for blk in out.split("Interface ")[1:]:
        name = blk.split(None, 1)[0]
        if name == "ap0" or "type managed" not in blk or (want and name != want):
            continue
        m = re.search(r"channel (\d+)", blk)
        if m:
            return m.group(1)
    return ""


def to_int(v, default=0):
    try:
        return int(v)
    except (TypeError, ValueError):
        return default


